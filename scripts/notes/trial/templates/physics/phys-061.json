{
  "format": 1,
  "concept_id": "phys-061",
  "subject": "physics",
  "title": "Stopping distance (template test)",
  "key_idea": "**Stopping distance = thinking distance + braking distance.** Every factor changes one of the two.",
  "sections": [
    {
      "heading": "Try it: stop the car",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Change the speed, the driver and the road. Watch both distances change."
        },
        {
          "type": "diagram",
          "diagram": {
            "kind": "slider",
            "alt": "Set the speed, driver and road to see thinking, braking and stopping distance.",
            "inputs": [
              {
                "id": "v",
                "label": "Speed",
                "unit": "m/s",
                "min": 5,
                "max": 31,
                "step": 1,
                "value": 13
              },
              {
                "id": "t",
                "label": "Driver",
                "choices": [
                  {
                    "label": "Alert",
                    "value": 0.7
                  },
                  {
                    "label": "Tired",
                    "value": 1.2
                  },
                  {
                    "label": "On their phone",
                    "value": 1.5
                  }
                ]
              },
              {
                "id": "a",
                "label": "Road",
                "choices": [
                  {
                    "label": "Dry",
                    "value": 6.5
                  },
                  {
                    "label": "Wet",
                    "value": 3.9
                  },
                  {
                    "label": "Icy",
                    "value": 1.3
                  }
                ]
              }
            ],
            "outputs": [
              {
                "label": "Thinking distance",
                "unit": "m",
                "formula": "v * t",
                "bar": true
              },
              {
                "label": "Braking distance",
                "unit": "m",
                "formula": "v^2 / (2 * a)",
                "bar": true
              },
              {
                "label": "Stopping distance",
                "unit": "m",
                "formula": "v * t + v^2 / (2 * a)"
              }
            ],
            "scene": {
              "kind": "road",
              "thinking": 0,
              "braking": 1
            }
          }
        }
      ]
    },
    {
      "heading": "Waves (scene test)",
      "blocks": [
        {
          "type": "diagram",
          "diagram": {
            "kind": "slider",
            "alt": "Change the frequency and amplitude of a wave.",
            "inputs": [
              {
                "id": "f",
                "label": "Frequency",
                "unit": "Hz",
                "min": 1,
                "max": 10,
                "step": 1,
                "value": 3
              },
              {
                "id": "A",
                "label": "Amplitude",
                "unit": "cm",
                "min": 1,
                "max": 5,
                "step": 0.5,
                "value": 2
              }
            ],
            "outputs": [
              {
                "label": "Wavelength (wave speed 340 m/s)",
                "unit": "m",
                "formula": "340 / f",
                "decimals": 1
              },
              {
                "label": "Period",
                "unit": "s",
                "formula": "1 / f",
                "decimals": 2
              }
            ],
            "scene": {
              "kind": "wave",
              "amplitude": "A",
              "frequency": "f"
            }
          }
        }
      ]
    },
    {
      "heading": "Particles (scene test)",
      "blocks": [
        {
          "type": "diagram",
          "diagram": {
            "kind": "slider",
            "alt": "Heat water and watch its particles change state.",
            "inputs": [
              {
                "id": "T",
                "label": "Temperature of water",
                "unit": "°C",
                "min": -20,
                "max": 120,
                "step": 5,
                "value": 20
              }
            ],
            "outputs": [
              {
                "label": "Temperature",
                "unit": "K",
                "formula": "T + 273",
                "decimals": 0
              }
            ],
            "scene": {
              "kind": "particles",
              "temperature": "T",
              "melting": 0,
              "boiling": 100
            }
          }
        }
      ]
    }
  ],
  "checks": [
    {
      "q": "What happens to braking distance when speed doubles?",
      "a": "It increases four times."
    },
    {
      "q": "Which distance does tiredness change?",
      "a": "Thinking distance."
    }
  ],
