{
  "format": 1,
  "concept_id": "phys-061",
  "subject": "physics",
  "title": "Stopping distance (template test)",
  "key_idea": "**Stopping distance = thinking distance + braking distance.** Every factor changes one of the two.",
  "sections": [
    {
      "heading": "Try it: stop the car",
      "blocks": [
        { "type": "paragraph", "text": "Change the speed, the driver and the road. Watch both distances change." },
        {
          "type": "diagram",
          "diagram": {
            "kind": "slider",
            "alt": "Set the speed, driver and road to see thinking, braking and stopping distance.",
            "inputs": [
              { "id": "v", "label": "Speed", "unit": "m/s", "min": 5, "max": 31, "step": 1, "value": 13 },
              { "id": "t", "label": "Driver", "choices": [{ "label": "Alert", "value": 0.7 }, { "label": "Tired", "value": 1.2 }, { "label": "On their phone", "value": 1.5 }] },
              { "id": "a", "label": "Road", "choices": [{ "label": "Dry", "value": 6.5 }, { "label": "Wet", "value": 3.9 }, { "label": "Icy", "value": 1.3 }] }
            ],
            "outputs": [
              { "label": "Thinking distance", "unit": "m", "formula": "v * t", "bar": true },
              { "label": "Braking distance", "unit": "m", "formula": "v^2 / (2 * a)", "bar": true },
              { "label": "Stopping distance", "unit": "m", "formula": "v * t + v^2 / (2 * a)" }
            ]
          }
        }
      ]
    }
  ],
  "checks": [
    { "q": "What happens to braking distance when speed doubles?", "a": "It increases four times." },
    { "q": "Which distance does tiredness change?", "a": "Thinking distance." }
  ],
  "boards": {
    "aqa": { "spec_codes": ["AQA 4.5.6.3"], "exam_phrases": ["reaction time increases", "less friction between the tyres and the road"], "mistakes": [] }
