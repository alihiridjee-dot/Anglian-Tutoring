# Supabase — Anglian Tutoring (project ref: peohauhwquuvghrpmotf)
# The URL and publishable key are safe to expose (they ship in the client bundle).
# The service role key is SECRET — never commit a real value. Copy it from the
# Supabase dashboard: Project Settings → API → service_role.

# Server-side (SSR / server functions)
SUPABASE_PROJECT_ID=peohauhwquuvghrpmotf
SUPABASE_URL=https://peohauhwquuvghrpmotf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_MdTxLYK6CMmNKrsL_HTktg_g05RBAV0
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — SECRET, server/script only. Never prefix this with VITE_: that would
# ship your secret key to every browser. Used by scripts/stripe-seed.ts; the
# edge functions read it from Supabase function secrets, not from here.
# Dashboard: Developers → API keys. Use sk_test_… until you're taking real money.
STRIPE_SECRET_KEY=

# Anthropic — SECRET, server functions only. Never prefix with VITE_.
# Required by every AI surface: MCQ generation, session blurbs, weekly summaries
# and feedback, spec-point suggestions, and the tutor's chat-reply draft. Without
# it those all fail with "ANTHROPIC_API_KEY not configured" — the rest of the app
# is unaffected. Console: https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API — SECRET, server only. Powers the demo dashboard's sales
# chat: the visitor's enquiry is written to `leads` and then pushed to the team's
# WhatsApp. All three must be set for delivery; with any of them missing the chat
# still works and still records the lead, it just falls back to offering the
# visitor a wa.me link. So you can ship the chat before Meta verifies you.
# Meta dashboard: developers.facebook.com → your app → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Where enquiries are delivered — the team's own WhatsApp number, E.164 digits.
WHATSAPP_TO=447530863009
# Optional. Meta only allows free-form text to someone who messaged you in the
# last 24 hours; outside that window you need an approved template. Set the
# template's name here (4 body params: name, email, phone, message) to use it.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_GB

# Client-side (Vite build-time, VITE_ prefix is exposed to the browser)
VITE_SUPABASE_PROJECT_ID=peohauhwquuvghrpmotf
VITE_SUPABASE_URL=https://peohauhwquuvghrpmotf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_MdTxLYK6CMmNKrsL_HTktg_g05RBAV0
# The public number behind the wa.me links (floating button + demo chat hand-off).
# Public by nature — it's printed on the site. Digits only, no "+".
VITE_WHATSAPP_NUMBER=447530863009
